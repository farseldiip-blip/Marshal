// Prisma schema for Marshal Al-Gezira standalone backend.
// Mirrors the prior Firestore data model; PostgreSQL is now the
// single source of truth. No Firebase dependencies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- User / Admin ----------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())

  bookings Booking[] // future linkage if bookings are tied to users
}

enum UserRole {
  USER
  ADMIN
}

// ---------------- Room ----------------
model Room {
  id          String   @id @default(cuid())
  name        String
  type        String
  quantity    Int      @default(1)
  isActive    Boolean  @default(true)
  price       Float
  description String?
  images      String[] // stored as JSON array of URLs
  amenities   String[] // stored as JSON array of labels
  capacity    Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([type])
}

// ---------------- Booking ----------------
model Booking {
  id            String        @id @default(cuid())
  guestName     String
  email         String?
  phone         String?
  roomId        String?
  roomName      String
  roomType      String
  checkin       String // YYYY-MM-DD (date-only, server-normalized)
  checkout      String // YYYY-MM-DD (date-only, server-normalized)
  adults        Int           @default(1)
  children      Int           @default(0)
  rooms         Int           @default(1)
  guests        Int           @default(1)
  nights        Int
  total         Float
  revenue       Float
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  accessToken   String        @unique // server-generated ownership proof
  cancelReason  String?       // audit trail: why a booking was auto-cancelled
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  room     Room?     @relation(fields: [roomId], references: [id])
  payments Payment[]
  User     User?     @relation(fields: [userId], references: [id])
  userId   String?

  @@index([roomId])
  @@index([status])
  @@index([checkin])
  @@index([checkout])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ---------------- Payment ----------------
model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  provider          String
  providerReference String?
  transactionId     String?
  amount            Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  webhookVerified   Boolean       @default(false)
  paidAt            DateTime?
  metadata          Json? // free-form provider metadata (no secrets)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([providerReference])
}

// ---------------- Content (admin-managed) ----------------

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  category    String?
  image       String?
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String?
  image     String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id        String   @id @default(cuid())
  author    String?
  email     String?
  rating    Int // 1..5
  comment   String?
  status    ReviewStatus @default(PENDING)
  approved  Boolean     @default(false) // legacy field kept for backward compat
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([approved])
}

model Amenity {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}
