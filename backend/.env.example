DATABASE_URL="postgresql://user:password@localhost:5432/marshal?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
FRONTEND_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"
PORT=8080

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment mode: "demo" (local dev, no real money) or "paymob" (production)
PAYMENT_MODE=demo

# Paymob (payments) — required when PAYMENT_MODE=paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# Booking lifecycle scheduler
# How long an UNPAID PENDING booking may stay before auto-cancel (minutes).
# Use 120 in production; set to 2 to test the flow quickly.
BOOKING_PAYMENT_TIMEOUT_MINUTES=120
# No-show grace after check-in date (hours)
NO_SHOW_GRACE_HOURS=24
# How often the sweep runs (ms). Default 300000 (5 min). Lower for testing.
SCHEDULER_INTERVAL_MS=300000
