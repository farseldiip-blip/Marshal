# ============================================================
#  PAYMENT SECRETS — NEVER COMMIT, NEVER EXPOSE TO FRONTEND.
#  This file is loaded ONLY inside Cloud Functions (server-side).
#  The frontend (js/payment-config.js) holds ONLY the public
#  `endpoint` URL + provider name — no keys.
#
#  Copy this file to `.env` and fill real values from your
#  provider dashboard. `.env` is git-ignored.
# ============================================================

# ---- Provider selection ----
PAYMENT_PROVIDER=paymob
# PAYMENT_PROVIDER=stripe

# ---- Paymob (server-side secrets — backend only) ----
# TODO: fill from https://dashboard.paymob.com (developers section)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_ID=
# Base URL (regional). Default https://accept.paymob.com (Egypt).
# KSA: https://ksa.paymob.com  UAE: https://uae.paymob.com  OMAN: https://oman.paymob.com
PAYMOB_BASE_URL=https://accept.paymob.com

# ---- Admin bootstrap (server-side) ----
# Comma-separated allowlist of emails permitted to SELF-grant the
# `admin` custom claim on first run. After an admin exists, only an
# existing admin may grant claims to others. NEVER leave this empty
# in production, and NEVER put a normal public user here.
ADMIN_EMAILS=admin@marshalhotel.com

# ---- Stripe (server-side secrets — backend only) ----
# TODO: fill from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Firebase (service account is auto-provided by the fn runtime) ----
# (no manual secret needed when deployed as a Cloud Function)
