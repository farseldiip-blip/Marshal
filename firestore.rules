rules_version = '2';

// Marshal Al-Gezira — Firestore Security Rules
// ---------------------------------------------------------
// IMPORTANT: the client-side Firebase config is PUBLIC by design.
// These rules are the ONLY thing protecting write access.
// Paste into: Firebase Console -> Firestore Database -> Rules.
//
// SECURITY MODEL
//  - Public READ: marketing/booking data is readable (concept site).
//  - BOOKING CREATE: anyone may create a booking, BUT only with the
//    allowed ownership fields, forced to status:"Pending" and
//    paymentStatus:"Unpaid", and NEVER with financial fields.
//  - BOOKING UPDATE/DELETE: financial + status fields are ADMIN-ONLY
//    (verified custom claim `admin == true`). A signed-in non-admin
//    may not touch those fields.
//  - payments/{txnId}: NEVER writable by any client. Only the
//    Cloud Functions backend (Admin SDK) writes here.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isSignedIn() { return request.auth != null; }

    // Fields that constitute FINANCIAL TRUTH. Only the backend may write.
    function financialFields() {
      return ['paymentStatus','paymentIntentId','paymentProvider',
              'amount','currency','paidAt','paymentMeta'];
    }

    // Single-doc collections (hotel info, settings)
    match /hotel/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings
    match /bookings/{id} {
      allow read: if true;

      // PUBLIC create (the legitimate booking-creation flow).
      // Allowed IFF: no financial fields, forced safe defaults.
      allow create: if
        !hasAny(request.resource.data.keys(), financialFields()) &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.paymentStatus == 'Unpaid';

      // UPDATE: admin may change anything; a signed-in non-admin may
      // NOT write financial fields nor the booking status.
      allow update: if
        isAdmin() ||
        ( isSignedIn() &&
          !('paymentStatus' in request.writeFields) &&
          !('paymentIntentId' in request.writeFields) &&
          !('paymentProvider' in request.writeFields) &&
          !('amount' in request.writeFields) &&
          !('currency' in request.writeFields) &&
          !('paidAt' in request.writeFields) &&
          !('paymentMeta' in request.writeFields) &&
          !('status' in request.writeFields)
        );

      // DELETE: admin only.
      allow delete: if isAdmin();
    }

    // Payment audit collection — client writes are FORBIDDEN.
    // Only Cloud Functions (Admin SDK) may write.
    match /payments/{txnId} {
      allow read: if true;
      allow write: if false;
    }

    // Other list collections (rooms, customers, reviews, gallery, menu, amenities)
    match /{collection}/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
